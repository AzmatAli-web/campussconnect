# Milestone 26: illustrative STAGING-only variables, not actual credentials.
# DO NOT COMMIT a filled copy. Use the authorized secret store.
# NODE_ENV=production enables production safeguards even for staging.
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://staging-campus.example.edu.pk
MONGODB_URI=
FIREBASE_PROJECT_ID=
UNIVERSITY_ID=
UNIVERSITY_EMAIL_DOMAINS=
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/on-staging-server.json

# Offline preflight and read-only smoke checks; not release approval.
CAMPUS_PILOT_STAGE=staging
CAMPUS_PILOT_DATA_POLICY=fictional-only
CAMPUS_PILOT_API_BASE_URL=https://staging-api-campus.example.edu.pk
CAMPUS_PILOT_OWNER=
CAMPUS_PILOT_ROLLBACK_OWNER=
CAMPUS_PILOT_APPROVED_TEST_ACCOUNTS=
# Only opt in for read-only smoke after staging is authorized:
# CAMPUS_PILOT_SMOKE_ACK=staging-readonly

# Private upload files, real Finance records and push dispatcher MUST NOT
# be assumed safe for production without the separate security review.
